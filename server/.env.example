# ---------- Server ----------
PORT=5000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local MongoDB, or paste your MongoDB Atlas connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/bug-hunter-royale

# ---------- Auth ----------
# Long random string used to sign login tokens. NEVER share it.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Code runner ----------
# local  = run code on this PC (demo / testing only, no key needed)
# judge0 = run code on Judge0 cloud sandbox (needs the key below)
CODE_RUNNER=local

# ---------- Judge0 (only used when CODE_RUNNER=judge0) ----------
# Get a free key: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=paste_your_rapidapi_key_here
# 63 = JavaScript (Node.js 12). Only change if your Judge0 has a newer Node id.
JUDGE0_LANGUAGE_ID=63
